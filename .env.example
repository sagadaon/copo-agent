# Combined Agent Games endpoint — environment template.
# Copy to .env for local runs. On Railway, set these in the dashboard
# (Variables tab) instead — never commit a real .env.

# HMAC secret from the agent dashboard ("Rotate Secret"). Official name first;
# HMAC_SECRET is accepted as a fallback. REQUIRED in production.
AGENT_GAMES_HMAC_SECRET=<redacted>
# HMAC_SECRET=<redacted>

# Port. Railway sets PORT automatically; local default is 3000.
PORT=3000

# --- Proof Gatekeeper ---
# stub (default, fail-closed) | mock (local tests) | disabled (operator choice)
ZKVERIFY_CHECK_MODE=stub
# PROOF_TIMEOUT_MS=50000
# SEEN_FILE=/data/seen.json  # when a Railway Volume is mounted at /data

# --- Steal the VFY ---
# Strategy params: p0,p1,p2,p3,0,0,0,0 (see strategy.js for semantics).
# Default: 10,30,0,0,0,0,0,0
STRATEGY_PARAMS=10,30,0,0,0,0,0,0

# Private salt for the commitment hash. Any integer (decimal or 0x-hex).
# REQUIRED for Steal; if missing, Steal turns return 503 and Gatekeeper
# keeps working. Keep secret. Changing it changes the commitment —
# re-register the new hash in the dashboard before the next round.
STRATEGY_SALT=replace-with-a-random-secret-integer

# Optional: Kurier API key for on-chain audit pointers (Steal). Omit to disable.
# KURIER_API_KEY=<redacted>
